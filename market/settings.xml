<?xml version="1.0" encoding="UTF-8"?>
<!-- Build-time Maven mirror: the Docker build VM's egress to Maven Central
     (Cloudflare) is unreliable from this network; Aliyun serves the same
     artifacts. Used only inside the Dockerfile build stage. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>aliyun-central</id>
      <name>Aliyun mirror of Maven Central</name>
      <url>https://maven.aliyun.com/repository/central</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
