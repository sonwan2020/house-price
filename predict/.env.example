# Copy to .env and adjust as needed. All values are optional; the
# defaults below live in app/config.py.

# Server
HOST=127.0.0.1
PORT=8000

# Model (reported by GET /api/v1/model-info; bump after retraining)
MODEL_VERSION=1.0

# Absolute overrides (defaults point at app/models/):
# MODEL_PATH=/absolute/path/to/house_price_model.joblib
# METRICS_PATH=/absolute/path/to/model_metrics.json
