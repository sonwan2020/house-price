# Copy to .env and adjust as needed. docker-compose.yaml at the repo root
# reads this file for ${VAR} interpolation; all values are optional.

# Host port published for the API
API_PORT=8000

# Host port published for the portal (Next.js frontend)
PORTAL_PORT=3000

# Model tag reported by GET /api/v1/model-info; bump after retraining
MODEL_VERSION=1.0

# Host port published for the market analysis API (Java)
MARKET_PORT=8080

# Regression model trained into the API image:
#   linear | linear_positive | ridge | lasso
# Default is linear_positive (non-negative OLS) without lot_size — the
# variant with the most defensible coefficient signs on this collinear
# dataset (see predict/README.md, "Model selection").
MODEL_TYPE=linear_positive

# Comma-separated features to exclude from training
DROP_FEATURES=lot_size
