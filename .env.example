# Copy to .env and adjust as needed. docker-compose.yaml at the repo root
# reads this file for ${VAR} interpolation; all values are optional.

# Host port published for the API
API_PORT=8000

# Host port published for the portal (Next.js frontend)
PORTAL_PORT=3000

# Model tag reported by GET /api/v1/model-info; bump after retraining
MODEL_VERSION=1.0
