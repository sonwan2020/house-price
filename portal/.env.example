# Copy to .env.local and adjust as needed (all values optional).
#
# Base URL of the Python prediction service. The portal always calls the
# API server-side (route handlers / server components), so the browser
# never needs to reach it directly.
#
#   local dev (API run from predict/ or via docker compose) : http://127.0.0.1:8000
#   docker compose (portal container)                       : http://api:8000  (set by compose, not here)
PYTHON_API_URL=http://127.0.0.1:8000
